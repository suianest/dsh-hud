{
  "name": "dsh-hud-capsule",
  "version": "0.5.2",
  "description": "Windows 常驻悬浮胶囊 + 面板，把 DeepSeek Harness 贴在桌面上（DSH 插件 + Electron 伴生应用）",
  "type": "module",
  "main": "./plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./plugin/locale/*.json",
    "./icon": "./plugin/icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "plugin/index.js",
    "plugin/package.json",
    "plugin/locale/*.json",
    "plugin/icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "desktop",
    "overlay",
    "capsule",
    "electron",
    "windows"
  ],
  "author": "suianest",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suianest/dsh-hud.git"
  },
  "homepage": "https://github.com/suianest/dsh-hud#readme",
  "bugs": {
    "url": "https://github.com/suianest/dsh-hud/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "private": false
}
